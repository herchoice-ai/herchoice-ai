# Copy to .env and fill in. Never commit the real .env file.

# Privacy: long random secret used to turn phone numbers into anonymous codes.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
HERCHOICE_ID_SECRET=

# Reply language by default: ha (Hausa) or en (English)
HERCHOICE_DEFAULT_LANG=ha

# How long (in seconds) a chat is kept in memory when the user has not sent SAVE
HERCHOICE_SESSION_TTL=1800

# Demo only. MUST be false in a pilot: answer only from clinically approved content.
HERCHOICE_ALLOW_DRAFT=false

# Optional: grounded rephrasing with any OpenAI-compatible endpoint (e.g. a self-hosted open-weight model)
HERCHOICE_LLM_BASE_URL=
HERCHOICE_LLM_API_KEY=
HERCHOICE_LLM_MODEL=

# Optional: speech models (install with: pip install -e ".[speech]")
HERCHOICE_ASR_MODEL=openai/whisper-small
HERCHOICE_TTS_MODEL=facebook/mms-tts-hau

# WhatsApp Cloud API (https://developers.facebook.com/docs/whatsapp/cloud-api)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
